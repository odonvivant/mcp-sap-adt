{
  "name": "mcp-sap-adt",
  "version": "0.1.0",
  "description": "MCP server for investigating and mapping SAP ECC/S4HANA ABAP systems via ADT (discovery, search, usage references, transports, ATC) with guardrailed mutation tools.",
  "main": "dist/src/server.js",
  "bin": {
    "mcp-sap-adt": "dist/src/server.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node ./dist/src/server.js",
    "setup": "node ./dist/scripts/setup.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "mcp-guardrails": "git+https://github.com/odonvivant/mcp-guardrails.git#v0.1.0",
    "sap-adt-client": "git+https://github.com/odonvivant/sap-adt-client.git#v0.4.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.4"
  }
}
